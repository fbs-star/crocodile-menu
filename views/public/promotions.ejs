<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= settings.restaurantName %> — <%= ui.promo %></title>
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <div class="menu-header">
    <a class="back-btn" href="/?lang=<%= lang %>">←</a>
    <div class="brand">
      <% if (settings.parentProperty) { %><div class="small"><%= settings.parentProperty %></div><% } %>
      <div class="big serif"><%= settings.restaurantName %></div>
    </div>
    <div class="header-actions">
      <% if (settings.callStaffEnabled) { %>
        <button type="button" class="call-staff-btn" id="callStaffBtn" data-label="🔔 <%= ui.callStaff %>" data-sent="✓ <%= ui.callStaffSent %>">🔔 <%= ui.callStaff %></button>
      <% } %>
      <div class="lang-switch">
        <% LANGS.forEach(function(l) { %>
          <a class="lang-pill <%= l.code === lang ? 'active' : '' %>" href="/promotions?lang=<%= l.code %>"><%= l.label %></a>
        <% }) %>
      </div>
    </div>
  </div>

  <% if (!promos.length) { %>
    <div class="empty-note" style="padding:60px 0;">No promotions published yet.</div>
  <% } else { %>
    <div class="promo-grid">
      <% promos.forEach(function(p) { %>
        <div class="promo-card">
          <div class="img"><% if (p.imageUrl) { %><img src="<%= p.imageUrl %>" alt=""><% } %></div>
          <div class="body">
            <div class="title serif"><%= t(p.title) %></div>
            <% if (t(p.subtitle)) { %><div class="sub"><%= t(p.subtitle) %></div><% } %>
            <% if (p.priceText) { %><div class="price"><%= p.priceText %></div><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (settings.callStaffEnabled) { %>
  <script>
  (function () {
    var btn = document.getElementById('callStaffBtn');
    if (!btn) return;
    var defaultLabel = btn.getAttribute('data-label');
    var sentLabel = btn.getAttribute('data-sent');
    var cooldownMs = 30000;
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      btn.disabled = true;
      btn.classList.add('sent');
      btn.textContent = sentLabel;
      fetch('/call', { method: 'POST' }).catch(function () {});
      setTimeout(function () {
        btn.disabled = false;
        btn.classList.remove('sent');
        btn.textContent = defaultLabel;
      }, cooldownMs);
    });
  })();
  </script>
  <% } %>
</body>
</html>
