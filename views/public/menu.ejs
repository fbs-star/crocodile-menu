<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= settings.restaurantName %> — <%= group === 'drinks' ? ui.drinks : (group === 'wine' ? ui.wine : ui.food) %></title>
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <div class="menu-header">
    <a class="back-btn" href="/?lang=<%= lang %>">←</a>
    <div class="brand">
      <% if (settings.parentProperty) { %><div class="small"><%= settings.parentProperty %></div><% } %>
      <div class="big serif"><%= settings.restaurantName %></div>
    </div>
    <div class="header-actions">
      <% if (settings.callStaffEnabled) { %>
        <button type="button" class="call-staff-btn" id="callStaffBtn" data-label="🔔 <%= ui.callStaff %>" data-sent="✓ <%= ui.callStaffSent %>">🔔 <%= ui.callStaff %></button>
      <% } %>
      <div class="lang-switch">
        <% LANGS.forEach(function(l) { %>
          <a class="lang-pill <%= l.code === lang ? 'active' : '' %>" href="/menu/<%= group %>?lang=<%= l.code %><%= selectedCat ? ('&cat=' + selectedCat.id) : '' %>"><%= l.label %></a>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="menu-body">
    <div class="menu-sidebar">
      <% if (!cats.length) { %>
        <div class="empty-note" style="padding:20px;">No categories published yet.</div>
      <% } %>
      <% cats.forEach(function(c) { %>
        <a class="<%= selectedCat && selectedCat.id === c.id ? 'active' : '' %>" href="/menu/<%= group %>?lang=<%= lang %>&cat=<%= c.id %>">
          <%= t(c.name) %>
        </a>
      <% }) %>
    </div>
    <div class="menu-content">
      <% if (selectedCat) { %>
        <h1 class="serif"><%= t(selectedCat.name) %></h1>
        <div class="divider"><div></div><div></div></div>
      <% } %>

      <% if (!selectedCat || !items.length) { %>
        <div class="empty-note"><%= selectedCat ? 'No items published in this category yet.' : 'No menu items to show yet.' %></div>
      <% } else { %>
        <div class="item-grid">
          <% items.forEach(function(it) { %>
            <div class="item-card">
              <div class="img">
                <% if (it.imageUrl) { %><img src="<%= it.imageUrl %>" alt=""><% } else { %>&#127860;<% } %>
              </div>
              <div class="body">
                <% if (it.tags && it.tags.length) { %>
                  <div class="tags"><% it.tags.forEach(function(tag){ %><span class="tag"><%= tag %></span><% }) %></div>
                <% } %>
                <% var itemDiet = dietaryDefs.filter(function(d){ return it[d.field]; }); %>
                <% if (itemDiet.length) { %>
                  <div class="item-dietary">
                    <% itemDiet.forEach(function(d) { %>
                      <svg class="dietary-icon" viewBox="<%= d.viewBox %>" aria-hidden="true"><title><%= ui[d.labelKey] %></title><g transform="translate(0,<%= d.h %>) scale(0.1,-0.1)" fill="currentColor"><path d="<%- d.path %>"/></g></svg>
                    <% }) %>
                  </div>
                <% } %>
                <div class="name serif"><%= t(it.name) %></div>
                <% if (t(it.desc)) { %><div class="desc"><%= t(it.desc) %></div><% } %>
                <div class="item-footer">
                  <% if (it.price) { %>
                    <div class="price"><%= Number(it.price).toLocaleString('en-US') %> THB</div>
                  <% } else { %><div></div><% } %>
                  <% if (it.unit) { %><span class="unit-pill"><%= t(UNIT_LABELS[it.unit]) %></span><% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <% var catHasDiet = items.some(function(it){ return dietaryDefs.some(function(d){ return it[d.field]; }); }); %>
        <% if (catHasDiet) { %>
          <div class="dietary-legend">
            <div class="dietary-legend__title"><%= ui.dietLegendTitle %></div>
            <div class="dietary-legend__items">
              <% dietaryDefs.forEach(function(d) { %>
                <div class="dietary-legend__item">
                  <svg class="dietary-icon" viewBox="<%= d.viewBox %>" aria-hidden="true"><g transform="translate(0,<%= d.h %>) scale(0.1,-0.1)" fill="currentColor"><path d="<%- d.path %>"/></g></svg>
                  <span class="dietary-legend__label"><%= ui[d.labelKey] %></span>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <% if (settings.callStaffEnabled) { %>
  <script>
  (function () {
    var btn = document.getElementById('callStaffBtn');
    if (!btn) return;
    var defaultLabel = btn.getAttribute('data-label');
    var sentLabel = btn.getAttribute('data-sent');
    var cooldownMs = 30000;
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      btn.disabled = true;
      btn.classList.add('sent');
      btn.textContent = sentLabel;
      fetch('/call', { method: 'POST' }).catch(function () {});
      setTimeout(function () {
        btn.disabled = false;
        btn.classList.remove('sent');
        btn.textContent = defaultLabel;
      }, cooldownMs);
    });
  })();
  </script>
  <% } %>
  <%- include('../partials/allergy_notice') %>
</body>
</html>
